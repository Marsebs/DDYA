    for fila in Datos:
        identificador, nombres, apellidos, sexo, fecha, municipio, comunidad, semanas, ths, comorbilidad, faltan, vencidas, nunca = fila
        nacimiento = date.fromisoformat(fecha)
        personas.append({
            "id": identificador,
            "nombre": nombres + " " + apellidos,
            "documento": "TEST" + identificador[-3:],
            "sexo": sexo,
            "nacimiento": nacimiento,
            "tipo_doc": "",
            "municipio": municipio,
            "comunidad": comunidad,
            "semanas": semanas,
            "ths": bool(ths),
            "comorbilidad": bool(comorbilidad),
            "faltan": lista_texto(faltan),
            "vencidas": lista_texto(vencidas),
            "nunca": lista_texto(nunca),})
        persona = personas[-1]
        anios = edad_meses(nacimiento, corte) // 12
        persona["tipo_doc"] = "RC" if anios < 7 else ("TI" if anios < 18 else "CC")
    return personas


def estado_vacuna(persona, vacuna, corte):
    meses = edad_meses(persona["nacimiento"], corte)
    anios = meses // 12
    sexo = persona["sexo"]
    semanas = persona["semanas"]

    if vacuna in Serie:
        if meses >= 72:
            return "NO_APLICA"
        edades, maximo = Serie[vacuna]
        exigibles = [edad for edad in edades if meses >= edad]
        if not exigibles:
            return "NO_APLICA"
        if vacuna in persona["faltan"]:
            return "NO_APLICA" if meses > maximo else "PENDIENTE"
        return "AL_DIA"

    if vacuna == "VPH":
        objetivo = (sexo == "F" and 9 <= anios <= 17) or (sexo == "M" and anios == 9)
    elif vacuna == "FA":
        objetivo = meses >= 18 and persona["municipio"] in Municipios
    elif vacuna == "INFLUENZA":
        gestante = sexo == "F" and semanas >= 14
        objetivo = gestante or 7 <= meses <= 23 or anios > 60 or persona["ths"] or persona["comorbilidad"]
    elif vacuna == "COVID19":
        objetivo = anios > 60 or persona["ths"] or persona["comorbilidad"]
    elif vacuna == "TD":
        objetivo = sexo == "F" and 9 <= anios <= 49
    else:
        objetivo = False

    if not objetivo:
        return "NO_APLICA"
    if vacuna in persona["faltan"] or vacuna in persona["nunca"]:
        return "PENDIENTE"
    if vacuna in persona["vencidas"]:
        return "VENCIDO"
    return "AL_DIA"


def evaluar(persona, corte):
    estados = {vacuna: estado_vacuna(persona, vacuna, corte) for vacuna in Pesos}
    pendientes = [v for v in Pesos if estados[v] in ("PENDIENTE", "VENCIDO")]
    carga = sum(Pesos[v] for v in pendientes)
    zona = Municipios[persona["municipio"]][3] if pendientes else 0
    total = carga + zona
    if not pendientes:
        lista = ""
    elif total > 10:
        lista = "URGENTE"
    elif total >= 6:
        lista = "IMPORTANTE"
    else:
        lista = "CORTO PLAZO"
    detalle = ", ".join(v + " +" + str(Pesos[v]) for v in pendientes)
    if pendientes:
        detalle += ", " + Municipios[persona["municipio"]][0] + " +" + str(zona)
        detalle += " = " + str(total) + " -> " + lista
    else:
        detalle = "Sin pendientes"
    return {
        "estados": estados,
        "pendientes": pendientes,
        "carga": carga,
        "puntaje": total,
        "lista": lista,
        "detalle": detalle,
    }


def agrupar(personas, corte):
    grupos = {}
    for persona in personas:
        persona["resultado"] = evaluar(persona, corte)
        clave = (persona["municipio"], persona["comunidad"])
        grupos.setdefault(clave, []).append(persona)
    return grupos


def indice(grupo, municipio):
    con_pendientes = [p for p in grupo if p["resultado"]["pendientes"]]
    proporcion = 100 * len(con_pendientes) / len(grupo)
    carga = sum(p["resultado"]["carga"] for p in grupo) / len(grupo)
    carga_normalizada = 100 * carga / sum(Pesos.values())
    riesgo_zona = 100 * Municipios[municipio][3] / 7
    valor = proporcion * 0.60 + carga_normalizada * 0.30 + riesgo_zona * 0.10
    return valor, len(con_pendientes)


