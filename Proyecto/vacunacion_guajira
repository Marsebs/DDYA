def mensaje(municipio, comunidad, grupo):
    vacunas = {}
    for persona in grupo:
        for vacuna in persona["resultado"]["pendientes"]:
            vacunas[vacuna] = vacunas.get(vacuna, 0) + 1
    principales = sorted(vacunas, key=peso_mayor)[:3]
    pendientes = sum(bool(p["resultado"]["pendientes"]) for p in grupo)
    valor, _ = indice(grupo, municipio)
    mas = ", ".join(principales) if principales else "ningun biologico"
    return (
        f"{comunidad}, {Municipios[municipio][0]}: {pendientes} de {len(grupo)} "
        f"registros tienen pendientes. Mas frecuentes: {mas}. "
        f"Indice: {valor:.1f}/100. Revisen los carnets y consulten el servicio PAI. "
        "El resumen solo cubre personas registradas.")


def mostrar_mensajes(grupos):
    print("\nMENSAJES PARA LIDERES")
    for (municipio, comunidad), grupo in grupos.items():
        print(mensaje(municipio, comunidad, grupo))


def mostrar_kpis(personas, grupos, milisegundos):
    listas = {"URGENTE": 0, "IMPORTANTE": 0, "CORTO PLAZO": 0, "SIN_PENDIENTES": 0}
    estados = {"AL_DIA": 0, "PENDIENTE": 0, "VENCIDO": 0}
    for persona in personas:
        lista = persona["resultado"]["lista"] or "SIN_PENDIENTES"
        listas[lista] += 1
        for estado in persona["resultado"]["estados"].values():
            if estado in estados:
                estados[estado] += 1
    aplicables = sum(estados.values())
    porcentaje = 100 * estados["AL_DIA"] / aplicables if aplicables else 0
    print("\nKPIS")
    print("Personas:", len(personas), "| Comunidades:", len(grupos))
    print("Listas:", listas)
    print("Estados:", estados)
    print(f"Al dia entre dosis aplicables: {porcentaje:.1f}%")
    print(f"Tiempo de calculo: {milisegundos:.2f} ms")


