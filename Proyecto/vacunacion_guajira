def edad_meses(nacimiento, corte):
    meses = (corte.year - nacimiento.year) * 12 + corte.month - nacimiento.month
    if corte.day < nacimiento.day:
        meses -= 1
    return max(0, meses)


def lista_texto(texto):
    if not texto:
        return set()
    return set(texto.split(","))


